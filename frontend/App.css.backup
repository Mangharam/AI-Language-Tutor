:root {
  --bg: #eef2f5;
  --ink: #1b2a36;
  --muted: #5d6f7d;
  --panel: #ffffff;
  --line: #d3dde4;
  --accent: #0f6b66;
  --accent-ink: #ffffff;
  --fix: #fff4d6;
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--ink); font-family: "Inter", system-ui, sans-serif; }
.app { max-width: 720px; height: 100vh; margin: 0 auto; display: flex; flex-direction: column; padding: 20px 16px; }
.top h1 { font-family: "Fraunces", Georgia, serif; font-size: 1.9rem; margin: 0; }
.top p { margin: 4px 0 16px; color: var(--muted); }
.chat { flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 12px; padding: 4px 2px 12px; }
.bubble { max-width: 85%; padding: 12px 14px; border-radius: 14px; line-height: 1.5; }
.bubble p { margin: 0; }
.bubble.user { align-self: flex-end; background: var(--accent); color: var(--accent-ink); border-bottom-right-radius: 4px; }
.bubble.tutor { align-self: flex-start; background: var(--panel); border: 1px solid var(--line); border-bottom-left-radius: 4px; }
.bubble.muted { color: var(--muted); }
.correction { margin-top: 10px; padding: 10px 12px; background: var(--fix); border-radius: 8px; }
.correction-label { font-size: 0.85rem; color: var(--muted); margin-bottom: 2px !important; }
.correction-text { font-weight: 500; }
.changes { margin: 8px 0 0; padding-left: 18px; font-size: 0.92rem; }
.composer { display: flex; gap: 8px; padding-top: 8px; }
.composer input { flex: 1; padding: 12px 14px; font: inherit; border: 1px solid var(--line); border-radius: 10px; background: var(--panel); }
.composer input:focus-visible, .composer button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.composer button { padding: 0 20px; font: inherit; font-weight: 500; background: var(--accent); color: var(--accent-ink); border: 0; border-radius: 10px; cursor: pointer; }
.composer button:disabled { opacity: 0.5; cursor: not-allowed; }

/* Day 2: progress panel and error tags */
.progress { background: var(--panel); border: 1px solid var(--line); border-radius: 12px; padding: 12px 14px; margin-bottom: 12px; }
.progress.empty { color: var(--muted); font-size: 0.92rem; }
.stats { display: flex; gap: 20px; flex-wrap: wrap; }
.stats div { display: flex; flex-direction: column; }
.stats b { font-family: "Fraunces", Georgia, serif; font-size: 1.4rem; }
.stats span { font-size: 0.8rem; color: var(--muted); }
.weak { margin: 10px 0 0; font-size: 0.9rem; line-height: 2; }
.tag { display: inline-block; padding: 1px 8px; margin-right: 6px; border-radius: 999px; background: #dff0ee; color: var(--accent); font-size: 0.8rem; font-weight: 500; }
.link { margin-top: 8px; padding: 0; background: none; border: 0; color: var(--muted); font: inherit; font-size: 0.82rem; text-decoration: underline; cursor: pointer; }
.changes li { margin-bottom: 4px; }

/* Day 3: CEFR level cards */
.levels { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 10px; }
.level { display: flex; flex-direction: column; gap: 2px; }
.level-label { font-size: 0.8rem; color: var(--muted); }
.level-cefr { font-family: "Fraunces", Georgia, serif; font-size: 1.6rem; line-height: 1.1; }
.bar { height: 6px; background: var(--line); border-radius: 999px; overflow: hidden; margin: 4px 0; }
.bar-fill { height: 100%; background: var(--accent); border-radius: 999px; transition: width 0.5s ease; }
.level small { font-size: 0.75rem; color: var(--muted); }
.level small.up { color: #1c7a3d; }
.level small.down { color: #b3402a; }
.note { margin: 0 0 10px; font-size: 0.82rem; color: var(--muted); }
.stats { padding-top: 10px; border-top: 1px solid var(--line); }
.highlights { margin: 8px 0 0 !important; font-size: 0.88rem; }
.tag.gold { background: #fdf0c8; color: #6b4e00; }
@media (prefers-reduced-motion: reduce) { .bar-fill { transition: none; } }

/* Day 4: tabs, practice and review */
.tabs { display: flex; gap: 4px; margin-bottom: 10px; border-bottom: 1px solid var(--line); }
.tab { padding: 8px 16px; font: inherit; font-weight: 500; color: var(--muted); background: none; border: 0; border-bottom: 2px solid transparent; cursor: pointer; }
.tab.active { color: var(--accent); border-bottom-color: var(--accent); }
.tab:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
.panel { flex: 1; overflow-y: auto; padding: 8px 2px; }
.panel .meta { color: var(--muted); font-size: 0.9rem; margin: 0 0 6px; }
.panel .muted { color: var(--muted); }
.question { font-family: "Fraunces", Georgia, serif; font-size: 1.5rem; line-height: 1.3; margin: 8px 0 16px; }
.options { display: grid; gap: 8px; }
.option { padding: 12px 14px; text-align: left; font: inherit; background: var(--panel); border: 1px solid var(--line); border-radius: 10px; cursor: pointer; }
.option:hover:not(:disabled) { border-color: var(--accent); }
.option:disabled { cursor: default; }
.option.right { background: #dcf1e3; border-color: #1c7a3d; }
.option.wrong { background: #f9e0da; border-color: #b3402a; }
.feedback { margin-top: 16px; padding: 12px 14px; background: var(--panel); border: 1px solid var(--line); border-radius: 10px; }
.feedback p { margin: 0 0 10px; }
.primary { padding: 10px 18px; font: inherit; font-weight: 500; background: var(--accent); color: var(--accent-ink); border: 0; border-radius: 10px; cursor: pointer; }
.primary:focus-visible, .option:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

/* Day 5: voice input */
.composer .mic { background: var(--panel); color: var(--accent); border: 1px solid var(--accent); }
.composer .mic.live { background: #b3402a; border-color: #b3402a; color: #fff; animation: pulse 1.2s ease-in-out infinite; }
.voice-note { margin: 6px 2px 0; font-size: 0.8rem; color: var(--muted); min-height: 1.2em; }
@keyframes pulse { 50% { opacity: 0.7; } }
@media (prefers-reduced-motion: reduce) { .composer .mic.live { animation: none; } }
